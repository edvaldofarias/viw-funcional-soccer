                "Media__LocalPath": "${workspaceFolder}/.local/media"
            }
        },
        {
            "name": "Worker (validate source only)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/backend/src/Viw.Worker/bin/Debug/net10.0/Viw.Worker.dll",
            "args": ["--Imports:ValidateSourceOnly=true", "--Imports:RunOnce=true"],
            "cwd": "${workspaceFolder}/backend/src/Viw.Worker",
            "stopAtEntry": false,
            "console": "internalConsole",
            "env": {
                "DOTNET_ENVIRONMENT": "Development",
