@model CupPage
@{
    var cup=Model.Edition.Edition;
    var root=PortalRoutes.Cup(cup.Slug);
    var overview=Model.Overview;
    var finished=cup.Status=="Archived";
    var first=overview?.Phases.FirstOrDefault();
    var rows=Model.General?overview?.Overall:first?.Standings;
    var campaigns=overview?.Overall.Where(x=>x.Played>0).ToArray() ?? [];
    var bestAttack=campaigns.Length>0?campaigns.Where(x=>x.GoalsFor==campaigns.Max(y=>y.GoalsFor)).ToArray():[];
    var bestDefense=campaigns.Length>0?campaigns.Where(x=>x.GoalsAgainst==campaigns.Min(y=>y.GoalsAgainst)).ToArray():[];
    var scorers=(Model.Scorers ?? []).Where(x=>x.Statistics.Goals>0).OrderByDescending(x=>x.Statistics.Goals).ThenBy(x=>x.Player.Name).ToArray();
    var bestPlayers=(Model.Awards ?? []).Where(x=>x.Scope=="Championship"&&x.PlayerId!=null&&x.Code.Contains("ballon",StringComparison.OrdinalIgnoreCase)).ToArray();
}
<partial name="_EditionHeader" model="Model.Edition" />
<section class="shell section">
    <nav class="nav nav-pills gap-2 mb-4" aria-label="Seções do campeonato"><a class="nav-link active" href="#classificacao">Classificação</a><a class="nav-link" href="#fases">Jogos por fase</a><a class="nav-link" href="#equipes">Equipes e jogadores</a><a class="nav-link" href="#artilharia">Artilharia</a>@if(finished){<a class="nav-link" href="#destaques">Destaques finais</a>}</nav>
    @if(finished){<div class="alert alert-primary" role="status"><strong>Campeonato encerrado.</strong> Consulte a campanha das equipes, os resultados de cada fase e os destaques da competição.</div>}
    <div class="section-heading" id="classificacao"><div><p class="eyebrow">A CAMPANHA DAS EQUIPES</p><h2>@(Model.General?"Classificação geral":"Classificação da primeira fase")</h2></div></div>
    @if(finished){<nav class="nav nav-tabs mb-3" aria-label="Tipo de classificação"><a class="nav-link @(!Model.General?"active":"")" href="@root#classificacao">Primeira fase</a><a class="nav-link @(Model.General?"active":"")" href="@(root+"?visao=geral#classificacao")">Classificação geral</a></nav>}
    @if(Model.General){<p class="text-body-secondary">Colocação pela fase atingida. Equipes eliminadas na mesma fase compartilham posição; a decisão da final só é considerada quando o placar informa um vencedor. Empates sem decisão por pênaltis permanecem sem desempate. V/E/D e gols abrangem todas as fases.</p>}
    else {<p class="text-body-secondary">Posição e pontos registrados no Copa Fácil. J/V/E/D e gols consideram os jogos encerrados desta fase. “—” indica informação ainda não disponível; não é usado o nome da equipe como critério de desempate.</p>}
    <div class="table-responsive border rounded-3"><table class="table table-hover align-middle mb-0 standings-table"><caption class="visually-hidden">@(Model.General?"Classificação geral":"Classificação da primeira fase")</caption><thead class="table-light"><tr><th scope="col">Pos.</th><th scope="col">Equipe</th>@if(!Model.General){<th scope="col"><abbr title="Pontos">PTS</abbr></th>}<th scope="col"><abbr title="Jogos">J</abbr></th><th scope="col"><abbr title="Vitórias">V</abbr></th><th scope="col"><abbr title="Empates">E</abbr></th><th scope="col"><abbr title="Derrotas">D</abbr></th><th scope="col"><abbr title="Gols pró">GP</abbr></th><th scope="col"><abbr title="Gols contra">GC</abbr></th><th scope="col"><abbr title="Saldo de gols">SG</abbr></th></tr></thead><tbody>
    @foreach(var row in rows ?? []){<tr><td>@(row.Position?.ToString()??"—")</td><th scope="row"><a href="@PortalRoutes.Team(cup.Slug,row.Team.Id)">@row.Team.Name</a></th>@if(!Model.General){<td><strong>@(row.Points?.ToString("0.##")??"—")</strong></td>}<td>@row.Played</td><td>@row.Wins</td><td>@row.Draws</td><td>@row.Losses</td><td>@row.GoalsFor</td><td>@row.GoalsAgainst</td><td>@(row.GoalsFor-row.GoalsAgainst)</td></tr>}
    </tbody></table></div>
    @if(rows==null||rows.Count==0){<div class="alert alert-light border mt-3">A classificação desta fase ainda não está disponível.</div>}
</section>
@if(finished){<section class="shell section section-tight" id="destaques"><div class="section-heading"><div><p class="eyebrow">OS DESTAQUES DA COMPETIÇÃO</p><h2>Quem marcou esta copa.</h2></div></div><div class="row g-3">
    <div class="col-md-4"><article class="card h-100 shadow-sm"><div class="card-body"><p class="eyebrow">MELHOR ATAQUE</p><h3 class="h4">Mais gols marcados</h3>@foreach(var row in bestAttack){<p><a href="@PortalRoutes.Team(cup.Slug,row.Team.Id)"><strong>@row.Team.Name</strong></a><br />@row.GoalsFor gols em @row.Played jogos</p>}@if(bestAttack.Length==0){<p>Resultados ainda não disponíveis.</p>}</div></article></div>
    <div class="col-md-4"><article class="card h-100 shadow-sm"><div class="card-body"><p class="eyebrow">MELHOR DEFESA</p><h3 class="h4">Menos gols sofridos</h3>@foreach(var row in bestDefense){<p><a href="@PortalRoutes.Team(cup.Slug,row.Team.Id)"><strong>@row.Team.Name</strong></a><br />@row.GoalsAgainst gols em @row.Played jogos</p>}@if(bestDefense.Length==0){<p>Resultados ainda não disponíveis.</p>}</div></article></div>
    <div class="col-md-4"><article class="card h-100 shadow-sm"><div class="card-body"><p class="eyebrow">BALLON D’OR</p><h3 class="h4">Melhor jogador</h3>@foreach(var award in bestPlayers){<p><a href="@PortalRoutes.Player(award.PlayerId!.Value)"><strong>@award.PlayerName</strong></a></p>}@if(bestPlayers.Length==0){<p class="text-body-secondary">O prêmio de melhor jogador da competição ainda não foi atribuído.</p>}<a href="@(root+"/premiacoes")">Ver premiações oficiais →</a></div></article></div>
</div><p class="small text-body-secondary mt-3">Ataque e defesa comparam totais de gols nos jogos encerrados, com todos os empatados exibidos. As equipes podem ter disputado quantidades diferentes de jogos. O melhor jogador é uma decisão oficial confirmada pelo Admin.</p></section>}
<section class="shell section" id="fases"><div class="section-heading"><div><p class="eyebrow">DO PRIMEIRO JOGO À DECISÃO</p><h2>Jogos por fase</h2></div><a class="text-link" href="@(root+"/jogos")">Filtrar jogos →</a></div>
    <div class="accordion" id="competition-phases">@foreach(var stage in overview?.Phases ?? []){var key="phase-"+stage.Phase.Id.ToString("N");var expanded=stage==first;<article class="accordion-item"><h3 class="accordion-header"><button class="accordion-button @(expanded?"":"collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#@key" aria-expanded="@(expanded?"true":"false")" aria-controls="@key">@stage.Phase.Name <span class="badge text-bg-light ms-3">@stage.Matches.Count jogos</span></button></h3><div id="@key" class="accordion-collapse collapse @(expanded?"show":"")"><div class="accordion-body"><div class="match-grid">@foreach(var game in stage.Matches){<partial name="_MatchCard" model="new MatchCard(cup,game)" />}</div>@if(stage.Matches.Count==0){<p>Confrontos ainda não cadastrados.</p>}</div></div></article>}</div>
    @if(overview?.Phases.Count==0){<p>As fases ainda não estão disponíveis.</p>}
</section>
<section class="shell section section-tight" id="equipes"><div class="section-heading"><div><p class="eyebrow">EQUIPES E ELENCOS</p><h2>Quem entra em campo.</h2></div><a class="text-link" href="@(root+"/equipes")">Ver todas as equipes →</a></div><div class="row g-3">@foreach(var team in Model.Teams.Items){<div class="col-6 col-md-4 col-xl-3"><a class="card h-100 text-decoration-none team-tile" href="@PortalRoutes.Team(cup.Slug,team.Id)"><span class="team-avatar" aria-hidden="true">@PortalFormat.Initials(team.Name)</span><h3 class="h5">@team.Name</h3><span>Equipe e jogadores →</span></a></div>}</div></section>
<section class="shell section" id="artilharia"><div class="section-heading"><div><p class="eyebrow">OS GOLS DA COPA</p><h2>Artilharia</h2></div><a class="text-link" href="@(root+"/estatisticas/jogadores")">Estatísticas completas →</a></div>
    @if(scorers.Length>0){var goals=scorers[0].Statistics.Goals;<div class="alert alert-primary"><strong>@(scorers.Count(x=>x.Statistics.Goals==goals)>1?"Líderes da artilharia":"Líder da artilharia"):</strong> @string.Join(", ",scorers.Where(x=>x.Statistics.Goals==goals).Select(x=>x.Player.Name)) · @goals gols registrados.</div><div class="table-responsive"><table class="table table-striped"><thead><tr><th scope="col">Jogador</th><th scope="col">Gols</th></tr></thead><tbody>@foreach(var scorer in scorers){<tr><th scope="row"><a href="@PortalRoutes.Player(scorer.Player.Slug)">@scorer.Player.Name</a></th><td>@scorer.Statistics.Goals</td></tr>}</tbody></table></div>}else{<p>Nenhum gol individual registrado até o momento.</p>}
    <p class="small text-body-secondary">Artilharia calculada pelas súmulas importadas. O prêmio oficial de artilheiro é confirmado separadamente no Admin; súmulas incompletas podem limitar os totais.</p>
</section>
