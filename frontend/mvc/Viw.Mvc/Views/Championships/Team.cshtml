@model TeamPage
<partial name="_EditionHeader" model="Model.Edition" />
<section class="shell section"><div class="profile-heading"><viw-avatar kind="teams" entity-id="@(Model.Team.Team.Id)" name="@(Model.Team.Team.Name)" class="team-avatar jumbo"></viw-avatar><div><p class="eyebrow">EQUIPE DA EDIÇÃO</p><h2>@Model.Team.Team.Name</h2><p class="muted">@Model.Edition.Edition.Name · @Model.Edition.Edition.Year</p></div></div>
@if (Model.Team.Coaches.Count > 0) { <div class="panel"><h3>Comando da equipe</h3><ul class="coach-list">@foreach (var coach in Model.Team.Coaches) { <li><strong>@coach.Name</strong><span class="muted">@(coach.RoundId is { } round ? Model.Edition.Rounds.FirstOrDefault(x => x.Id == round)?.Name ?? "Rodada específica" : "Designação por período")</span></li> }</ul></div> }
<div class="section-heading"><div><p class="eyebrow">QUEM VESTIU ESSAS CORES</p><h2>Elenco e participações</h2></div></div>
@if (Model.Players.Items.Count == 0)
{
    <div class="empty-state"><h3>O elenco ainda não está disponível.</h3><p>Confira novamente quando os registros da equipe estiverem completos.</p></div>
}
else
{
    <p class="muted">Gols nas partidas encerradas desta equipe. Cartões amarelos e vermelhos da edição inteira; em caso de transferência, os cartões incluem todas as equipes. “—” indica informação indisponível.</p>
    <div class="table-wrap">
        <table data-table-page="@Model.Pager.Page">
            <caption class="sr-only">Elenco e estatísticas de @Model.Team.Team.Name</caption>
            <thead>
                <tr><th scope="col">Jogador</th><th scope="col">Nome na edição</th><th scope="col">Camisa</th><th scope="col">Posição</th><th scope="col" class="numeric">Gols</th><th scope="col" class="numeric"><abbr title="Cartões amarelos na edição">CA</abbr></th><th scope="col" class="numeric"><abbr title="Cartões vermelhos na edição">CV</abbr></th></tr>
            </thead>
            <tbody>
                @foreach (var entry in Model.Players.Items)
                {
                    <tr>
                        <td><button type="button" class="person-link player-details-trigger" data-player-details-url="@(PortalRoutes.Team(Model.Edition.Edition.Slug, Model.Team.Team.Id) + "/jogadores/" + entry.Player.Id.ToString("D"))" aria-haspopup="dialog" aria-controls="edition-player-dialog"><viw-avatar kind="sourceplayers" entity-id="@(entry.Player.Id)" name="@(entry.Player.Name)" class="avatar small" edition-id="@(Model.Edition.Edition.Id)"></viw-avatar>@entry.Player.Name<span class="sr-only">: detalhes neste campeonato</span></button></td>
                        <td>@entry.OriginalName</td>
                        <td>@(entry.ShirtNumber ?? "—")</td>
                        <td>@(entry.Position ?? "—")</td>
                        <td class="numeric goals-cell">@(entry.Statistics?.Goals.ToString() ?? "—")</td>
                        <td class="numeric">@(entry.Discipline?.YellowCards.ToString() ?? "—")</td>
                        <td class="numeric">@(entry.Discipline?.RedCards.ToString() ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
</section>
<dialog id="edition-player-dialog" class="player-dialog" aria-labelledby="edition-player-dialog-title">
    <header class="player-dialog-header">
        <div><p class="eyebrow">@Model.Edition.Edition.Name / DETALHES</p><h2 id="edition-player-dialog-title" class="sr-only">Detalhes do jogador no campeonato</h2></div>
        <button type="button" class="player-dialog-close" data-player-dialog-close aria-label="Fechar detalhes" autofocus>×</button>
    </header>
    <div class="player-dialog-body">
        <p data-player-dialog-status role="status">Carregando os detalhes...</p>
        <button type="button" class="button button-secondary" data-player-dialog-retry hidden>Tentar novamente</button>
        <div data-player-dialog-content aria-busy="false"></div>
    </div>
</dialog>
<section class="shell section section-tight"><div class="section-heading"><h2>Jogos da equipe</h2><a class="text-link" href="@(PortalRoutes.Cup(Model.Edition.Edition.Slug) + "/jogos?equipe=" + Model.Team.Team.Id.ToString("D"))">Todos os jogos ↗</a></div><div class="match-grid">@foreach (var game in Model.Matches.Items) { <partial name="_MatchCard" model="new MatchCard(Model.Edition.Edition, game)" /> }</div>@if (Model.Matches.Items.Count == 0) { <p class="muted">Ainda não há partidas cadastradas para esta equipe.</p> }</section>
