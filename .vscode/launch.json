            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5081",
                "ViwApi__BaseUrl": "http://localhost:5080/",
                "Site__PublicBaseUrl": "http://localhost:5081/"
