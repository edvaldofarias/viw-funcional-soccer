            "stopAtEntry": false,
            "console": "internalConsole",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5080",
                "ConnectionStrings__ViwDatabase": "Server=localhost,1433;Database=ViwDevelopment;User Id=sa;Password=LocalDev#2026!Viw;Encrypt=True;TrustServerCertificate=True",
                "Monitoring__ApiKey": "zif1q4KDE5cjRTdAw9Bhnuk8LSaNGIyvmUFVx37PZrMC6lg0",
                "Admin__BootstrapEmail": "admin@viw.local",
                "Admin__BootstrapPassword": "Admin#Local2026!",
                "Admin__DataProtectionKeysPath": "${workspaceFolder}/.local/admin-keys",
                "Media__LocalPath": "${workspaceFolder}/.local/media"
            }
        },
        {
            "name": "Worker",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/backend/src/Viw.Worker/bin/Debug/net10.0/Viw.Worker.dll",
            "args": [],
