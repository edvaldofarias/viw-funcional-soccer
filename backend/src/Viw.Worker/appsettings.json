{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "System.Net.Http.HttpClient": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Imports": {
    "Enabled": true,
    "RunOnce": false,
    "ValidateSourceOnly": false,
    "PollIntervalSeconds": 3600,
    "LeaseMinutes": 10
  },
  "CopaFacil": {
    "BaseUrl": "https://copafacil-web.firebaseio.com/events/",
    "TimeoutSeconds": 20,
    "RetryCount": 2,
    "MaxResponseBytes": 8388608
  },
  "Media": {
    "Enabled": true,
    "Driver": "Local",
    "LocalPath": "data/media",
    "MaxBytes": 10485760
  }
}
