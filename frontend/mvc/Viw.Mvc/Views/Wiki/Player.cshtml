@model WikiPlayerPage
@{
    var player = Model.Player.Player; var stats = Model.Player.Statistics;
    var history = Model.History.Items.OrderBy(x => x.Edition.Year).ThenBy(x => x.Edition.Semester).ToArray();
    var photos = history.Where(x => Uri.TryCreate(x.ImageUrl, UriKind.Absolute, out var uri) && uri.Scheme == "https").ToArray();
    var mostGoals = history.Where(x => x.Statistics != null).OrderByDescending(x => x.Statistics!.Goals).FirstOrDefault();
}
<section class="shell section"><nav class="breadcrumbs" aria-label="Caminho"><a href="/wiki">Wiki VIW</a><span>/</span><a href="/wiki/jogadores">Jogadores</a></nav>
<article class="wiki-article">
<header class="wiki-article-header"><p class="eyebrow">ARQUIVO HISTÓRICO VIW</p><h1>@player.Name</h1><p>Jogador de futebol da comunidade VIW</p><partial name="_Share" /></header>
<aside class="wiki-infobox"><h2>@player.Name</h2>
@if (photos.LastOrDefault() is { } portrait) { <figure><img src="/imagens/players/@player.Id?editionId=@portrait.Edition.Id" alt="@player.Name na edição @portrait.Edition.Name" referrerpolicy="no-referrer" /><figcaption>@portrait.Edition.Name · @portrait.Edition.Year</figcaption></figure> }
<h3>Informações do jogador</h3><dl><dt>Nome</dt><dd>@player.Name</dd><dt>Participações registradas</dt><dd>@Model.History.TotalCount</dd><dt>Presenças</dt><dd>@stats.KnownAppearances</dd><dt>Gols</dt><dd>@stats.Goals</dd></dl>
@if (history.LastOrDefault() is { } latest) { <h3>Passagem mais recente</h3><p><a href="@PortalRoutes.Team(latest.Edition.Slug, latest.Team.Id)">@latest.Team.Name</a><br />@latest.Edition.Name · @latest.Edition.Year</p> }
</aside>
<p><strong>@player.Name</strong> é um jogador da comunidade VIW. Seus cadastros em diferentes campeonatos estão reunidos nesta identidade, com as estatísticas de cada edição preservadas separadamente.</p>
<p>O arquivo registra <strong>@stats.KnownAppearances presenças e @stats.Goals gols</strong> em partidas encerradas.</p>
<nav class="wiki-toc" aria-label="Sumário"><strong>Sumário</strong><ol><li><a href="#carreira">Carreira</a></li><li><a href="#estatisticas">Estatísticas por campeonato</a></li><li><a href="#marcas">Recordes e marcas</a></li><li><a href="#galeria">Galeria</a></li><li><a href="#metodologia">Notas e metodologia</a></li></ol></nav>
<section id="carreira"><h2>Carreira</h2>
@if (history.Length == 0) { <p>As participações ainda não estão disponíveis.</p> }
<p><strong>Nomes usados:</strong> @string.Join(", ", Model.Player.Aliases ?? [])</p>
<div class="wiki-career">@foreach (var entry in history) { <article><small>@(entry.Edition.Semester)º semestre de @entry.Edition.Year</small><h3><a href="@PortalRoutes.Team(entry.Edition.Slug, entry.Team.Id)">@entry.Team.Name</a></h3><a href="@PortalRoutes.Cup(entry.Edition.Slug)">@entry.Edition.Name</a><p>@PortalFormat.Status(entry.Edition.Status) · Nome na origem: @entry.OriginalName</p></article> }</div>
</section>
<section id="estatisticas"><h2>Estatísticas por campeonato</h2><p>Resultados das equipes nos jogos com presença registrada do jogador. Pontos abaixo usam a referência de 3 por vitória e 1 por empate; não substituem a classificação oficial da copa.</p>
<div class="table-responsive"><table class="table table-bordered wiki-stats"><thead><tr><th>Equipe / campeonato</th><th>J</th><th>V</th><th>E</th><th>D</th><th>Pts</th><th>G</th><th>G/J</th><th>GP</th><th>GC</th><th>SG</th></tr></thead><tbody>
@foreach (var entry in history) { var s = entry.Statistics; var result = entry.Results;
<tr><th><a href="@PortalRoutes.Team(entry.Edition.Slug, entry.Team.Id)">@entry.Team.Name</a><br /><small>@entry.Edition.Name · @entry.Edition.Year/@entry.Edition.Semester</small></th><td>@(s?.KnownAppearances.ToString() ?? "—")</td><td>@(result?.Wins.ToString() ?? "—")</td><td>@(result?.Draws.ToString() ?? "—")</td><td>@(result?.Losses.ToString() ?? "—")</td><td>@(result is null ? "—" : (result.Wins * 3 + result.Draws).ToString())</td><td>@(s?.Goals.ToString() ?? "—")</td><td>@(s is { KnownAppearances: > 0 } ? ((decimal)s.Goals / s.KnownAppearances).ToString("0.00") : "—")</td><td>@(result?.GoalsFor.ToString() ?? "—")</td><td>@(result?.GoalsAgainst.ToString() ?? "—")</td><td>@(result is null ? "—" : (result.GoalsFor - result.GoalsAgainst).ToString("+0;-0;0"))</td></tr>
}
</tbody><tfoot><tr><th>Totais da carreira</th><td>@stats.KnownAppearances</td><td colspan="4">Todas as edições vinculadas</td><td>@stats.Goals</td><td>@(stats.KnownAppearances > 0 ? ((decimal)stats.Goals / stats.KnownAppearances).ToString("0.00") : "—")</td><td colspan="3">Gols de pênaltis de desempate não incluídos</td></tr></tfoot></table></div>
<h3>Disciplina</h3><p>@stats.YellowCards cartões amarelos e @stats.RedCards cartões vermelhos registrados.</p></section>
<section id="marcas"><h2>Recordes e marcas</h2><ul><li><strong>Total de gols:</strong> @stats.Goals em @stats.KnownAppearances presenças registradas.</li>
@if (mostGoals is { Statistics: { } best }) { <li><strong>Mais gols entre as participações desta página:</strong> @best.Goals por @mostGoals.Team.Name (@mostGoals.Edition.Name · @mostGoals.Edition.Year).</li> }
<li><strong>Histórico:</strong> @Model.History.TotalCount participações preservadas.</li></ul></section>
<section id="galeria"><h2>Galeria</h2><div class="wiki-gallery">@foreach (var entry in photos) { <figure><img src="/imagens/players/@player.Id?editionId=@entry.Edition.Id" alt="@player.Name por @entry.Team.Name em @entry.Edition.Year" loading="lazy" referrerpolicy="no-referrer" /><figcaption><strong>@entry.Edition.Year</strong><br />@entry.Team.Name<br />@entry.Edition.Name</figcaption></figure> }</div>@if (photos.Length == 0) { <p>Fotos históricas ainda não disponíveis.</p> }</section>
<section id="metodologia"><h2>Notas e metodologia</h2><ol><li>Os vínculos manuais reúnem a pessoa sem apagar cadastros originais, estatísticas ou fotos dos campeonatos.</li><li>Até a Copa do Mundo 2026, jogadores do elenco são considerados presentes nos jogos encerrados. Edições posteriores usam as presenças informadas.</li><li>Há @stats.UnknownAppearances registros com presença desconhecida e @stats.IncompleteSheets registros de súmulas parciais ou desatualizadas. Valor desconhecido não significa ausência.</li><li>Vitórias, empates e derrotas usam o placar da partida antes da disputa de pênaltis. GP e GC são gols das equipes nos jogos em que o jogador esteve presente.</li></ol></section>
<partial name="_Pagination" model="Model.Pager" />
</article></section>
