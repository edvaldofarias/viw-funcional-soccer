@model EditionDetailResponse
@{ var cup = Model.Edition; var root = PortalRoutes.Cup(cup.Slug); var path = Context.Request.Path.Value ?? ""; }
<section class="cup-header"><div class="shell"><nav class="breadcrumbs" aria-label="Caminho"><a href="/campeonatos">Campeonatos</a><span aria-hidden="true">/</span><a href="@root">@cup.Name</a></nav><div class="title-row"><div><p class="eyebrow">@cup.Year · @(cup.Semester)º semestre <span class="status status-@cup.Status.ToLowerInvariant()">@PortalFormat.Status(cup.Status)</span></p><h1 class="edition-image-title"><viw-avatar kind="editions" entity-id="@cup.Id" name="@cup.Name" class="team-avatar large"></viw-avatar>@cup.Name</h1></div><partial name="_Share" /></div><div class="edition-facts"><span><strong>@Model.Teams</strong> equipes</span><span><strong>@Model.Matches</strong> partidas cadastradas</span><a href="@PortalRoutes.WikiCup(cup.Slug)">Memória da copa ↗</a></div></div></section>
<div class="cup-nav-wrap"><nav class="shell cup-nav" aria-label="Navegação da copa"><a href="@root" class="@(path == root ? "active" : "")">Visão geral</a><a href="@(root + "/primeira-fase")" class="@(path == root + "/primeira-fase" ? "active" : "")" aria-current="@(path == root + "/primeira-fase" ? "page" : null)">Primeira Fase</a><a href="@(root + "/equipes")" class="@(path.Contains("/equipes") ? "active" : "")">Equipes</a><a href="@(root + "/jogos")" class="@(path.Contains("/jogos") ? "active" : "")">Jogos</a><a href="@(root + "/estatisticas")" class="@(path.Contains("/estatisticas") ? "active" : "")">Estatísticas</a><a href="@(root + "/premiacoes")" class="@(path.Contains("/premiacoes") ? "active" : "")">Premiações</a></nav></div>
