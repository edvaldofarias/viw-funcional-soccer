@model TeamsPage
<partial name="_EditionHeader" model="Model.Edition" />
<section class="shell section"><div class="section-heading"><div><p class="eyebrow">AS CORES DA COPA</p><h2>Equipes</h2></div><span class="muted">@Model.Teams.TotalCount participantes</span></div><div class="team-grid">@foreach (var team in Model.Teams.Items) { <a class="team-tile" href="@PortalRoutes.Team(Model.Edition.Edition.Slug, team.Id)"><span class="team-avatar large" aria-hidden="true">@PortalFormat.Initials(team.Name)</span><h3>@team.Name</h3><span class="text-link">Elenco e jogos ↗</span></a> }</div>@if (Model.Teams.Items.Count == 0) { <div class="empty-state"><h3>As equipes ainda não chegaram.</h3><p>Os participantes serão exibidos quando estiverem disponíveis.</p></div> }<partial name="_Pagination" model="Model.Pager" /></section>
