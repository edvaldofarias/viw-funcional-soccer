@model HomePage
<section class="wiki-hero"><div class="shell"><p class="eyebrow">A MEMÓRIA DO NOSSO FUTEBOL</p><h1>O nome muda.<br />A <em>história</em> continua.</h1><p>Os jogadores, suas equipes e os capítulos que conectam cada copa. Conheça a Wiki VIW.</p><form method="get" action="/wiki/jogadores" class="wiki-search"><label class="sr-only" for="busca">Nome ou apelido do jogador</label><input type="search" id="busca" name="busca" maxlength="100" placeholder="Quem você está procurando?" /><button class="button button-lime" type="submit">Buscar jogador <span aria-hidden="true">↗</span></button></form><a class="hero-secondary" href="/wiki/jogadores">Ver todos os jogadores →</a></div></section>
<section class="shell section"><div class="section-heading"><div><p class="eyebrow">CAPÍTULOS DA VIW</p><h2>Uma memória para cada copa</h2></div><a href="/campeonatos" class="text-link">Todos os campeonatos ↗</a></div><div class="history-grid">@foreach (var cup in Model.Editions.Items) { <a class="history-cup" href="@PortalRoutes.WikiCup(cup.Slug)"><span class="history-year">@cup.Year</span><div><p class="eyebrow">@(cup.Semester)º SEMESTRE</p><h3>@cup.Name</h3><span class="muted">Explorar a memória da edição</span></div><span aria-hidden="true">↗</span></a> }</div>@if (Model.Editions.Items.Count == 0) { <div class="empty-state"><h3>A memória está começando.</h3><p>As edições aparecerão assim que estiverem disponíveis.</p></div> }</section>
