@model VersusMetric
<div class="versus-metric">
    <strong>@Model.Left@if (Model.Advantage != 0) { <span class="versus-indicator @(Model.Advantage > 0 ? "favorable" : "unfavorable")" aria-hidden="true">@(Model.Advantage > 0 ? "↑" : "↓")</span><span class="sr-only">@(Model.Advantage > 0 ? "Vantagem" : "Desvantagem")</span> }</strong>
    <span>@Model.Label</span>
    <strong>@Model.Right@if (Model.Advantage != 0) { <span class="versus-indicator @(Model.Advantage < 0 ? "favorable" : "unfavorable")" aria-hidden="true">@(Model.Advantage < 0 ? "↑" : "↓")</span><span class="sr-only">@(Model.Advantage < 0 ? "Vantagem" : "Desvantagem")</span> }</strong>
</div>
