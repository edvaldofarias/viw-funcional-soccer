@model CatalogPage
<section class="shell page-header"><p class="eyebrow">O ARQUIVO DO NOSSO FUTEBOL</p><h1>Todos os campeonatos<span class="accent">.</span></h1><p>Cada copa tem seus jogos. Cada edição tem seus protagonistas. Explore a história completa.</p></section>
<section class="shell section section-tight"><form class="filter-bar" method="get" action="/campeonatos"><div><label for="ano">Ano da edição</label><input id="ano" name="ano" type="number" min="1900" max="2200" value="@Model.Year" placeholder="Todos os anos" /></div><button class="button button-primary" type="submit">Filtrar <span aria-hidden="true">→</span></button>@if (Model.Year is not null) { <a class="text-link" href="/campeonatos">Limpar filtro</a> }<span class="filter-count">@Model.Editions.TotalCount edições encontradas</span></form>@if (Model.Editions.Items.Count == 0) { <div class="empty-state"><h2>Nenhuma edição por aqui.</h2><p>Tente outro ano ou consulte todos os campeonatos.</p><a class="text-link" href="/campeonatos">Ver todas as copas →</a></div> } else { <div class="edition-grid">@foreach (var edition in Model.Editions.Items) { <partial name="_EditionCard" model="edition" /> }</div> }<partial name="_Pagination" model="Model.Pager" /></section>
