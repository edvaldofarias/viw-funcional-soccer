@model InstagramFeed
<section class="home-hero institution-hero">
    <div class="shell hero-grid">
        <div class="hero-copy">
            <p class="eyebrow"><span class="tiny-dot"></span> VIW FUNCIONAL SOCCER</p>
            <h1>Sai do sofá.<br /><em>Vem pra VIW.</em></h1>
            <p class="hero-description">Treine fundamentos, desenvolva seu jogo e viva o futebol com a nossa turma. Na VIW, treino, evolução e resenha fazem parte da mesma história.</p>
            <div class="button-row">
                <a class="button button-lime" href="#conheca">Conheça nossos treinos <span aria-hidden="true">↓</span></a>
                <a class="hero-secondary" href="https://www.instagram.com/viwfuncionalsoccer/" target="_blank" rel="noopener noreferrer">VIW no Instagram <span aria-hidden="true">↗</span></a>
            </div>
            <div class="institution-signature"><span>TREINO.</span><span>EVOLUÇÃO.</span><span>RESENHA.</span></div>
        </div>
        <div class="institution-poster" aria-label="VIW Funcional Soccer">
            <div class="poster-top"><span>O NOSSO FUTEBOL</span><span>↗</span></div>
            <div class="poster-field"><div aria-hidden="true"></div><img src="~/images/viw-instagram-profile.jpg" alt="Logo da VIW Funcional Soccer" width="150" height="150" /></div>
            <p>Funcional Soccer.<br /><strong>O seu jogo em movimento.</strong></p>
            <span class="poster-handle">@@viwfuncionalsoccer</span>
        </div>
    </div>
</section>
<section class="shell section instagram-feed" aria-labelledby="instagram-titulo">
    <div class="section-heading instagram-heading">
        <div><p class="eyebrow">DENTRO E FORA DE CAMPO</p><h2 id="instagram-titulo">A VIW no Instagram.</h2><p>Treinos, copas e os momentos da nossa comunidade.</p></div>
        <a class="instagram-profile" href="https://www.instagram.com/viwfuncionalsoccer/" target="_blank" rel="noopener noreferrer">
            <img src="~/images/viw-instagram-profile.jpg" alt="" width="50" height="50" />
            <span><strong>@@viwfuncionalsoccer</strong><small>Ver perfil no Instagram ↗</small></span>
        </a>
    </div>
    @if (Model.Status == InstagramFeedStatus.Available && Model.Posts.Count > 0) {
        <div class="instagram-grid">
            @foreach (var post in Model.Posts) {
                <a class="instagram-post" href="@post.Permalink" target="_blank" rel="noopener noreferrer">
                    @if (post.ImageUrl is not null) {
                        <img src="@post.ImageUrl" alt="" loading="lazy" referrerpolicy="no-referrer" />
                    } else {
                        <span class="instagram-post-placeholder" aria-hidden="true">VIW</span>
                    }
                    <span class="instagram-post-caption">@post.Caption</span>
                    <span class="sr-only">Abrir publicação no Instagram</span>
                </a>
            }
        </div>
    } else if (Model.Status == InstagramFeedStatus.Available) {
        <p class="instagram-feed-notice">Ainda não há publicações disponíveis no perfil.</p>
    } else {
        <p class="instagram-feed-notice">As publicações @(Model.Status == InstagramFeedStatus.NotConfigured ? "ainda não estão conectadas" : "estão temporariamente indisponíveis"). Acompanhe a VIW diretamente no Instagram.</p>
    }
</section>
<section class="shell section institution-about" id="conheca">
    <div><p class="eyebrow">PRAZER, SOMOS A VIW</p><h2>Treino de verdade.<br />Futebol de perto.</h2></div>
    <div><p class="institution-lead">Fundamentos, preparo e bola no pé.</p><p>Passe, condução, finalização, agilidade e coordenação: o futebol começa no treino. Entre circuitos, coletivos e copas, a VIW reúne aprendizado, convivência e vontade de jogar.</p><a class="text-link" href="https://www.instagram.com/viwfuncionalsoccer/" target="_blank" rel="noopener noreferrer">Conheça nosso dia a dia no Instagram ↗</a></div>
</section>
<section class="shell institution-training" aria-labelledby="treinos-titulo">
    <div class="section-heading"><div><p class="eyebrow">DO TREINO PARA O JOGO</p><h2 id="treinos-titulo">Encontre seu lugar em campo.</h2></div></div>
    <div class="institution-cards">
        <article class="institution-card"><span class="eyebrow">01 / FUNDAMENTOS</span><h3>Mais bola<br />no pé.</h3><p>Trabalhos de passe, condução e finalização, com exercícios individuais e em parceria.</p></article>
        <article class="institution-card"><span class="eyebrow">02 / MOVIMENTO</span><h3>Evolução<br />no treino.</h3><p>Circuitos, coordenação e agilidade para trabalhar o movimento que faz parte do futebol.</p></article>
        <article class="institution-card"><span class="eyebrow">03 / TURMAS E KIDS</span><h3>Futebol para<br />compartilhar.</h3><p>Treinos em turma, coletivos e atividades para a garotada. Consulte as opções e os horários com a equipe.</p></article>
    </div>
    <a class="button button-primary training-contact" href="https://www.instagram.com/viwfuncionalsoccer/" target="_blank" rel="noopener noreferrer">Quero conhecer as turmas ↗</a>
</section>
<section class="institution-explore"><div class="shell section">
    <div class="section-heading"><div><p class="eyebrow">ENTRE NO NOSSO JOGO</p><h2>A VIW, em cada capítulo.</h2></div></div>
    <div class="institution-cards">
        <a href="/campeonatos" class="institution-card"><span class="eyebrow">01 / AS COPAS</span><h3>A disputa<br />tem história.</h3><p>Encontre as edições, conheça as equipes e acompanhe jogos, estatísticas e premiações.</p><span class="text-link">Explorar campeonatos ↗</span></a>
        <a href="/wiki/jogadores" class="institution-card"><span class="eyebrow">02 / OS PROTAGONISTAS</span><h3>Quem entra<br />em campo.</h3><p>Conheça os jogadores e acompanhe suas trajetórias de uma copa à outra.</p><span class="text-link">Conhecer os jogadores ↗</span></a>
        <a href="/wiki" class="institution-card"><span class="eyebrow">03 / A NOSSA MEMÓRIA</span><h3>O jogo passa.<br />A história fica.</h3><p>Revisite as copas e os registros que fazem parte da memória da VIW.</p><span class="text-link">Visitar a Wiki VIW ↗</span></a>
    </div>
</div></section>
<section class="shell institution-instagram">
    <p class="eyebrow">O JOGO CONTINUA POR LÁ</p>
    <h2>Acompanhe a VIW.<br /><em>Faça parte dessa história.</em></h2>
    <p>Conheça as turmas e fale com a VIW pelo Instagram para saber como participar.</p>
    <a class="button button-lime" href="https://www.instagram.com/viwfuncionalsoccer/" target="_blank" rel="noopener noreferrer">@@viwfuncionalsoccer <span aria-hidden="true">↗</span></a>
</section>
