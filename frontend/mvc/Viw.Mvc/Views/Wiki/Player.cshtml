@model WikiPlayerPage
@{
    var player = Model.Player.Player; var stats = Model.Player.Statistics;
    var history = Model.History.Items.OrderBy(x => x.Edition.Year).ThenBy(x => x.Edition.Semester).ToArray();
    var photos = history.Where(x => Uri.TryCreate(x.ImageUrl, UriKind.Absolute, out var uri) && uri.Scheme ==
"https").ToArray();
    var records = Model.Player.Records ?? new PlayerRecordsResponse([], [], [], [], [], [], [], false);
    var results = Model.Player.Results;
    var awards = Model.Player.Awards ?? Array.Empty<PlayerAwardResponse>();
    var podium = Model.Player.Podium;
    var infoboxClass = "wiki-infobox" + (podium is { Titles: > 0 } ? " wiki-infobox-gold" :
        podium is { RunnersUp: > 0 } ? " wiki-infobox-silver" : podium is { ThirdPlaces: > 0 } ? " wiki-infobox-bronze" : "");
}
<section class="shell section">
    <nav class="breadcrumbs" aria-label="Caminho"><a href="/wiki">Wiki VIW</a><span>/</span><a
        href="/wiki/jogadores">Jogadores</a></nav>
        <div class="wiki-layout">
        <nav class="wiki-toc" aria-label="Sumário"><strong>Conteúdo</strong>
            <ol>
                <li><a href="#carreira">Carreira</a></li>
                <li><a href="#estatisticas">Estatísticas por campeonato</a></li>
                <li><a href="#marcas">Recordes e marcas</a></li>
                @if (awards.Count > 0) { <li><a href="#premios-individuais">Prêmios individuais</a></li> }
                <li><a href="#galeria">Galeria</a></li>
                <li><a href="#metodologia">Notas e metodologia</a></li>
            </ol>
        </nav>
        <article class="wiki-article">
            <header class="wiki-article-header">
                <p class="eyebrow">ARQUIVO HISTÓRICO VIW</p>
                <h1>@player.Name</h1>
                <p>Jogador de futebol da comunidade VIW</p>
                <partial name="_Share" />
            </header>
            <aside class="@infoboxClass" aria-label="Perfil e conquistas de @player.Name">
                <h2>@player.Name</h2>
                @{
                    var portrait = photos.LastOrDefault();
                    var portraitSource = portrait is not null
                        ? $"/imagens/players/{player.Id}?editionId={portrait.Edition.Id}"
                        : player.ImageAssetId is not null ? $"/imagens/players/{player.Id}" : PortalFormat.PlaceholderPortrait;
                }
                    <figure><img
                        src="@portraitSource" data-media-placeholder="@PortalFormat.PlaceholderPortrait"
                        alt="Foto de @player.Name" referrerpolicy="no-referrer" />
                        <figcaption>
                            @if (portrait is not null) {
                                <a href="@PortalRoutes.Team(portrait.Edition.Slug, portrait.Team.Id)">@portrait.Team.Name</a><br />
                                <span>@portrait.Edition.Name · @portrait.Edition.Year</span>
                            } else { <span>Foto do jogador</span> }
                        </figcaption>
                    </figure>
                <h3>Informações do jogador</h3>
                <dl>
                    <dt>Nome</dt>
                    <dd>@player.Name</dd>
                    <dt>Copas disputadas</dt>
                    <dd>@(Model.Player.CupsPlayed?.ToString() ?? "—")</dd>
                    <dt>Jogos</dt>
                    <dd>@stats.KnownAppearances</dd>
                    <dt>Gols</dt>
                    <dd>@stats.Goals</dd>
                    <dt>Cartões amarelos</dt>
                    <dd>@stats.YellowCards</dd>
                    <dt>Cartões vermelhos</dt>
                    <dd>@stats.RedCards</dd>
                    <dt>Vitórias</dt>
                    <dd>@(results?.Wins.ToString() ?? "—")</dd>
                    <dt>Empates</dt>
                    <dd>@(results?.Draws.ToString() ?? "—")</dd>
                    <dt>Derrotas</dt>
                    <dd>@(results?.Losses.ToString() ?? "—")</dd>
                    <dt>Títulos</dt>
                    <dd>@(podium?.Titles.ToString() ?? "—")</dd>
                    <dt>Vice-campeonatos</dt>
                    <dd>@(podium?.RunnersUp.ToString() ?? "—")</dd>
                    <dt>Terceiros lugares</dt>
                    <dd>@(podium?.ThirdPlaces.ToString() ?? "—")</dd>
                </dl>
                @if (history.LastOrDefault() is { } latest)
                {
                    <h3>@(Model.History.Page == 1 ? "Última equipe registrada" : "Equipe nesta página")</h3>
                    <p><a
                        href="@PortalRoutes.Team(latest.Edition.Slug, latest.Team.Id)">@latest.Team.Name</a><br />@latest.Edition.Name
                        · @latest.Edition.Year</p>
                    }
                </aside>
                <p><strong>@player.Name</strong> é um jogador da comunidade VIW. Seus cadastros em diferentes campeonatos estão
                    reunidos nesta identidade, com as estatísticas de cada edição preservadas separadamente.</p>
                    <p>O arquivo registra <strong>@stats.KnownAppearances jogos e @stats.Goals gols</strong> em partidas
                        encerradas.</p>
                        <section id="carreira">
                            <h2>Carreira</h2>
                            @if (history.Length == 0)
                            {
                                <p>As participações ainda não estão disponíveis.</p>
                            }
                            <p><strong>Nomes usados:</strong> @string.Join(", ", Model.Player.Aliases ?? [])</p>
                            <div class="wiki-career">@foreach (var entry in history) {
                                <article><small>@(entry.Edition.Semester)º
                                    semestre de @entry.Edition.Year</small>
                                    <div class="wiki-club"><viw-avatar kind="teams" entity-id="@(entry.Team.Id)" name="@(entry.Team.Name)" class="wiki-crest"></viw-avatar><h3><a href="@PortalRoutes.Team(entry.Edition.Slug, entry.Team.Id)">@entry.Team.Name</a></h3></div><a
                                    href="@PortalRoutes.Cup(entry.Edition.Slug)">@entry.Edition.Name</a>
                                    <p>@PortalFormat.Status(entry.Edition.Status) · Nome na origem: @entry.OriginalName</p>
                                </article>
                            }
                        </div>
                    </section>
                    <section id="estatisticas">
                        <h2>Estatísticas por campeonato</h2>
                        <p>Resultados das equipes nos jogos com participação confirmada do jogador. Pontos abaixo usam a referência de 3
                            por vitória e 1 por empate; não substituem a classificação oficial da copa.</p>
                            <div class="table-responsive" tabindex="0" role="region" aria-label="Estatísticas por campeonato, com rolagem horizontal">
                                <table class="table table-bordered wiki-stats">
                                    <thead>
                                        <tr>
                                            <th>Equipe / campeonato</th>
                                            <th>J</th>
                                            <th>V</th>
                                            <th>E</th>
                                            <th>D</th>
                                            <th>Pts</th>
                                            <th>G</th>
                                            <th>G/J</th>
                                            <th>GP</th>
                                            <th>GC</th>
                                            <th>SG</th>
                                            <th><abbr title="Cartões amarelos no campeonato">CA</abbr></th>
                                            <th><abbr title="Cartões vermelhos no campeonato">CV</abbr></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var entry in history)
                                        {
                                            var s = entry.Statistics; var result = entry.Results;
                                            <tr>
                                                <th><a
                                                    href="@PortalRoutes.Team(entry.Edition.Slug, entry.Team.Id)">@entry.Team.Name</a><br /><small>@entry.Edition.Name
                                                    · @entry.Edition.Year/@entry.Edition.Semester</small></th>
                                                    <td>@(s?.KnownAppearances.ToString() ?? "—")</td>
                                                    <td>@(result?.Wins.ToString() ?? "—")</td>
                                                    <td>@(result?.Draws.ToString() ?? "—")</td>
                                                    <td>@(result?.Losses.ToString() ?? "—")</td>
                                                    <td>@(result is null ? "—" : (result.Wins * 3 + result.Draws).ToString())</td>
                                                    <td>@(s?.Goals.ToString() ?? "—")</td>
                                                    <td>@(s is { KnownAppearances: > 0 } ? ((decimal)s.Goals /
                                                                                        s.KnownAppearances).ToString("0.00") : "—")</td>
                                                        <td>@(result?.GoalsFor.ToString() ?? "—")</td>
                                                        <td>@(result?.GoalsAgainst.ToString() ?? "—")</td>
                                                        <td>@(result is null ? "—" : (result.GoalsFor - result.GoalsAgainst).ToString("+0;-0;0"))
                                                        </td>
                                                        <td>@((entry.Discipline?.YellowCards ?? s?.YellowCards)?.ToString() ?? "—")</td>
                                                        <td>@((entry.Discipline?.RedCards ?? s?.RedCards)?.ToString() ?? "—")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                            <tfoot>
                                                <tr>
                                                    <th>Totais da carreira</th>
                                                    <td>@stats.KnownAppearances</td>
                                                    <td>@(results?.Wins.ToString() ?? "—")</td>
                                                    <td>@(results?.Draws.ToString() ?? "—")</td>
                                                    <td>@(results?.Losses.ToString() ?? "—")</td>
                                                    <td>@(results is null ? "—" : ((long)results.Wins * 3 + results.Draws).ToString())</td>
                                                    <td>@stats.Goals</td>
                                                    <td>@(stats.KnownAppearances > 0 ? ((decimal)stats.Goals /
                                                                                        stats.KnownAppearances).ToString("0.00") : "—")</td>
                                                        <td colspan="3">Gols de pênaltis de desempate não incluídos</td>
                                                        <td>@stats.YellowCards</td>
                                                        <td>@stats.RedCards</td>
                                                    </tr>
                                                </tfoot>
                                            </table>
                                        </div>
                                        <p>CA: cartões amarelos; CV: cartões vermelhos. Os cartões são totais do campeonato, não da equipe. Se
                                            houver mais de uma passagem na mesma edição, esses totais se repetem; a carreira conta cada cadastro
                                            vinculado uma única vez.</p>
                                            <h3>Disciplina</h3>
                                            <p>@stats.YellowCards cartões amarelos e @stats.RedCards cartões vermelhos registrados.</p>
                                        </section>
                                        <section id="marcas">
                                            <h2>Recordes e marcas</h2>
                                            <p><strong>Total de gols:</strong> @stats.Goals em @stats.KnownAppearances jogos registrados. Os recordes abaixo abrangem toda a carreira vinculada, não apenas esta página.</p>
                                            <partial name="_Records" model="records" />
                                        </section>
                                        @if (awards.Count > 0) {
                                        <section id="premios-individuais">
                                            <h2>Prêmios individuais</h2>
                                            <partial name="_IndividualAwards" model="awards" />
                                        </section>
                                        }
                                            <section id="galeria">
                                                <h2>Galeria</h2>
                                                <div class="wiki-gallery">@foreach (var entry in history) {
                                                    var hasPhoto = Uri.TryCreate(entry.ImageUrl, UriKind.Absolute, out var photoUri) && photoUri.Scheme == "https";
                                                    <figure><img
                                                        src="@(hasPhoto ? $"/imagens/players/{player.Id}?editionId={entry.Edition.Id}" : PortalFormat.PlaceholderPortrait)"
                                                        data-media-placeholder="@PortalFormat.PlaceholderPortrait"
                                                        alt="@(hasPhoto ? $"{player.Name} por {entry.Team.Name} em {entry.Edition.Year}" : $"Foto de {player.Name} não disponível nesta edição")" loading="lazy"
                                                        referrerpolicy="no-referrer" />
                                                        <figcaption><strong>@entry.Edition.Year/@entry.Edition.Semester</strong><div class="wiki-club"><viw-avatar kind="teams" entity-id="@(entry.Team.Id)" name="@(entry.Team.Name)" class="wiki-crest"></viw-avatar><a href="@PortalRoutes.Team(entry.Edition.Slug, entry.Team.Id)">@entry.Team.Name</a></div>@entry.Edition.Name
                                                        <span class="wiki-record-context">Classificação final: @(entry.Edition.Status == "Archived" && entry.FinalPosition is { } position ? $"{position}º lugar" : entry.Edition.Status == "Archived" ? "não disponível" : "campeonato não encerrado").</span>
                                                        @if (!hasPhoto) { <span class="wiki-record-context">Foto não disponível.</span> }
                                                        </figcaption>
                                                    </figure>
                                                }
                                            </div>@if (history.Length == 0) {
                                            <p>As participações ainda não estão disponíveis para a galeria.</p>
                                        }
                                    </section>
                                    <section id="metodologia">
                                        <h2>Notas e metodologia</h2>
                                        <ol>
                                            <li>Os vínculos manuais reúnem a pessoa sem apagar cadastros originais, estatísticas ou fotos dos
                                                campeonatos.</li>
                                                <li>Até a Copa do Mundo 2026, jogadores do elenco são considerados presentes nos jogos encerrados.
                                                    Edições posteriores usam os jogos com participação informada.</li>
                                                    <li>Há @stats.UnknownAppearances registros com participação desconhecida e @stats.IncompleteSheets registros
                                                        de súmulas parciais ou desatualizadas. Valor desconhecido não significa ausência.</li>
                                                        <li>Vitórias, empates e derrotas usam o placar da partida antes da disputa de pênaltis. GP e GC são gols
                                                            das equipes nos jogos em que o jogador esteve presente.</li>
                                                            <li>Em edições arquivadas, cartões usam os totais do jogador na origem quando disponíveis, pois súmulas
                                                                antigas podem não registrar esses eventos. Sem o total da origem, ou em edições em andamento, são
                                                                contados os eventos das partidas encerradas. As duas fontes não são somadas.</li>
                                                            <li>Jogos e resultados da carreira contam cada partida uma vez, mesmo com mais de um cadastro vinculado. Copas disputadas contam edições distintas com inscrição, incluindo campeonatos em andamento. Jogos sem placar conhecido não são classificados como vitória, empate ou derrota.</li>
                                                            <li>Maior vitória e derrota usam a diferença de gols nos jogos com participação confirmada, sem pênaltis de desempate. Empates entre recordes são preservados.</li>
                                                            <li>Sequências seguem a ordem das datas pela carreira inteira, inclusive entre campeonatos. Empates e participação desconhecida interrompem a sequência; ausências confirmadas não contam como partidas do jogador. Datas ausentes ou coincidentes impedem confirmar a sequência.</li>
                                                            <li>Melhor e pior classificação usam a classificação geral final das equipes nas edições encerradas, com os mesmos critérios da página do campeonato. Posições desconhecidas não são inventadas.</li>
                                                            <li>Títulos, vices e terceiros seguem essas classificações finais, sem depender de premiações individuais. O lateral é dourado se houver título, senão prateado se houver vice, senão bronze se houver terceiro lugar.</li>
                                                            </ol>
                                                        </section>
                                                        <partial name="_Pagination" model="Model.Pager" />
                                                    </article>
                                                    </div>
                                                </section>