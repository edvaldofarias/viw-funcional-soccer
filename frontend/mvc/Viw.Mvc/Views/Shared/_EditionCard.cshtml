@model EditionResponse
<a class="edition-card" href="@PortalRoutes.Cup(Model.Slug)">
    <div class="edition-card-top"><viw-avatar kind="editions" entity-id="@Model.Id" name="@Model.Name" class="team-avatar edition-logo"></viw-avatar><span
        class="status status-@Model.Status.ToLowerInvariant()">@PortalFormat.Status(Model.Status)</span></div>
        <div class="edition-watermark" aria-hidden="true">@Model.Year</div>
        <div class="edition-card-body">
            <p class="eyebrow">@Model.Year · @(Model.Semester)º semestre</p>
            <h3>@Model.Name</h3><span class="text-link">Explorar edição <span aria-hidden="true">↗</span></span>
        </div>
    </a>
