@model VersusMetric
<div class="versus-metric">
    <strong><span class="versus-value">@Model.Left</span>@if (Model.Advantage is { } advantage) { <span class="versus-indicator @(advantage == 0 ? "equal" : advantage > 0 ? "favorable" : "unfavorable")" aria-hidden="true">@(advantage == 0 ? "=" : advantage > 0 ? "↑" : "↓")</span><span class="sr-only">@(advantage == 0 ? "Valores iguais" : advantage > 0 ? "Vantagem" : "Desvantagem")</span> }</strong>
    <span>@Model.Label</span>
    <strong><span class="versus-value">@Model.Right</span>@if (Model.Advantage is { } rightAdvantage) { <span class="versus-indicator @(rightAdvantage == 0 ? "equal" : rightAdvantage < 0 ? "favorable" : "unfavorable")" aria-hidden="true">@(rightAdvantage == 0 ? "=" : rightAdvantage < 0 ? "↑" : "↓")</span><span class="sr-only">@(rightAdvantage == 0 ? "Valores iguais" : rightAdvantage < 0 ? "Vantagem" : "Desvantagem")</span> }</strong>
</div>
