@{ var seo = ViewData["Seo"] as SeoMetadata; }
@if (seo is not null) {
    <div class="share-control"><button type="button" class="button button-quiet" data-share-url="@seo.CanonicalUrl" data-share-title="@seo.Title"><span aria-hidden="true">↗</span> Compartilhar</button><span class="share-feedback" role="status" aria-live="polite"></span></div>
}
