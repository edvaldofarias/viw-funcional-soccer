@model TeamPage
<partial name="_EditionHeader" model="Model.Edition" />
<section class="shell section"><div class="profile-heading"><span class="team-avatar jumbo" aria-hidden="true">@PortalFormat.Initials(Model.Team.Team.Name)</span><div><p class="eyebrow">EQUIPE DA EDIÇÃO</p><h2>@Model.Team.Team.Name</h2><p class="muted">@Model.Edition.Edition.Name · @Model.Edition.Edition.Year</p></div></div>
@if (Model.Team.Coaches.Count > 0) { <div class="panel"><h3>Comando da equipe</h3><ul class="coach-list">@foreach (var coach in Model.Team.Coaches) { <li><strong>@coach.Name</strong><span class="muted">@(coach.RoundId is { } round ? Model.Edition.Rounds.FirstOrDefault(x => x.Id == round)?.Name ?? "Rodada específica" : "Designação por período")</span></li> }</ul></div> }
<div class="section-heading"><div><p class="eyebrow">QUEM VESTIU ESSAS CORES</p><h2>Elenco e participações</h2></div></div>@if (Model.Players.Items.Count == 0) { <div class="empty-state"><h3>O elenco ainda não está disponível.</h3><p>Confira novamente quando os registros da equipe estiverem completos.</p></div> } else { <div class="table-wrap"><table><caption class="sr-only">Inscrições de jogadores de @Model.Team.Team.Name</caption><thead><tr><th>Jogador</th><th>Nome na edição</th><th>Camisa</th><th>Posição</th><th>Registro</th></tr></thead><tbody>@foreach (var entry in Model.Players.Items) { <tr><td><a class="person-link" href="@PortalRoutes.Player(entry.Player.Slug)"><span class="avatar small" aria-hidden="true">@PortalFormat.Initials(entry.Player.Name)</span>@entry.Player.Name</a></td><td>@entry.OriginalName</td><td>@(entry.ShirtNumber ?? "—")</td><td>@(entry.Position ?? "—")</td><td><span class="muted">@(entry.ObservedUntil is null ? "Aberto" : "Encerrado")</span></td></tr> }</tbody></table></div> }<partial name="_Pagination" model="Model.Pager" /></section>
<section class="shell section section-tight"><div class="section-heading"><h2>Jogos da equipe</h2><a class="text-link" href="@(PortalRoutes.Cup(Model.Edition.Edition.Slug) + "/jogos?equipe=" + Model.Team.Team.Id.ToString("D"))">Todos os jogos ↗</a></div><div class="match-grid">@foreach (var game in Model.Matches.Items) { <partial name="_MatchCard" model="new MatchCard(Model.Edition.Edition, game)" /> }</div>@if (Model.Matches.Items.Count == 0) { <p class="muted">Ainda não há partidas cadastradas para esta equipe.</p> }</section>
