@model MatchPage
<partial name="_EditionHeader" model="Model.Edition" />
<section class="shell section"><div class="scoreboard panel"><div class="scoreboard-top"><span class="eyebrow">@(Model.Match.Title ?? "JOGO DA EDIÇÃO")</span><span class="status status-@Model.Match.Status.ToLowerInvariant()">@PortalFormat.Status(Model.Match.Status)</span></div><div class="scoreboard-score"><div class="scoreboard-team"><span class="team-avatar jumbo" aria-hidden="true">@PortalFormat.Initials(Model.Match.Home?.Name)</span><h2>@if (Model.Match.Home is { } home) { <a href="@PortalRoutes.Team(Model.Edition.Edition.Slug, home.Id)">@home.Name</a> } else { <span>A definir</span> }</h2></div><div class="scoreboard-numbers" aria-label="Placar @PortalFormat.Score(Model.Match.HomeScore) a @PortalFormat.Score(Model.Match.AwayScore)"><span>@PortalFormat.Score(Model.Match.HomeScore)</span><b>:</b><span>@PortalFormat.Score(Model.Match.AwayScore)</span></div><div class="scoreboard-team"><span class="team-avatar jumbo away" aria-hidden="true">@PortalFormat.Initials(Model.Match.Away?.Name)</span><h2>@if (Model.Match.Away is { } away) { <a href="@PortalRoutes.Team(Model.Edition.Edition.Slug, away.Id)">@away.Name</a> } else { <span>A definir</span> }</h2></div></div>
@if (Model.Match.HomePenalties is not null && Model.Match.AwayPenalties is not null) { <p class="text-center muted">Pênaltis: @Model.Match.HomePenalties × @Model.Match.AwayPenalties</p> }
<p class="muted scoreboard-date">@PortalFormat.Date(Model.Match.ScheduledAt, Model.Edition.Edition.TimeZoneId) @if (PortalFormat.HumanVenue(Model.Match.Venue)) { <span> · @Model.Match.Venue</span> }</p>@if (Model.Match.HomeScore is null || Model.Match.AwayScore is null) { <p class="muted">O placar ainda não está confirmado.</p> }</div>
<div class="section-heading"><div><p class="eyebrow">OS REGISTROS DA PARTIDA</p><h2>Dentro do jogo</h2></div></div>@if (Model.Players.Items.Count == 0) { <div class="empty-state"><h3>A súmula ainda não está disponível.</h3><p>As estatísticas dos jogadores serão exibidas quando os registros estiverem disponíveis.</p></div> } else { <div class="table-wrap"><table><caption class="sr-only">Estatísticas dos jogadores da partida</caption><thead><tr><th>Jogador</th><th>Equipe</th><th class="numeric">Gols</th><th class="numeric">Amarelos</th><th class="numeric">Vermelhos</th><th>Presença</th><th>Súmula</th></tr></thead><tbody>@foreach (var player in Model.Players.Items) { <tr><td>@if (player.PlayerId is { } id) { <a class="person-link" href="@PortalRoutes.Player(id)"><span class="avatar small" aria-hidden="true">@PortalFormat.Initials(player.Name)</span>@player.Name</a> } else { @player.Name }</td><td>@(player.TeamId == Model.Match.Home?.Id ? Model.Match.Home.Name : player.TeamId == Model.Match.Away?.Id ? Model.Match.Away.Name : "Equipe da partida")</td><td class="numeric strong">@PortalFormat.Score(player.Goals)</td><td class="numeric">@PortalFormat.Score(player.YellowCards)</td><td class="numeric">@PortalFormat.Score(player.RedCards)</td><td>@PortalFormat.Appearance(player.Appearances)</td><td><span class="status @(player.IsComplete ? "status-finished" : "status-unknown")">@(player.IsComplete ? "Completa" : "Parcial")</span></td></tr> }</tbody></table></div> }<partial name="_Pagination" model="Model.Pager" /><aside class="notice"><span class="notice-icon" aria-hidden="true">i</span><p>O traço (—) indica um valor ainda desconhecido. Súmulas parciais podem ser completadas ou corrigidas posteriormente.</p></aside></section>
