# Apenas para o perfil opcional sqlserver; use uma senha local forte.
SQLSERVER_SA_PASSWORD=

# Habilitar apenas após aplicar as migrations e configurar a conexão do Worker.
VIW_IMPORTS_ENABLED=false

# Mesma conexão para API, migrations e Worker; configure localmente, sem versionar credenciais.
ConnectionStrings__ViwDatabase=
# Chave de leitura de monitoramento, 32 a 512 caracteres aleatórios; vazia mantém o acesso fechado.
VIW_MONITORING_API_KEY=
