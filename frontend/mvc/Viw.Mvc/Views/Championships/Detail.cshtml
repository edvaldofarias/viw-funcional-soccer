@model CupPage
<partial name="_EditionHeader" model="Model.Edition" />
<section class="shell section"><div class="section-heading"><div><p class="eyebrow">DENTRO DAS QUATRO LINHAS</p><h2>Jogos da edição</h2></div><a class="text-link" href="@(PortalRoutes.Cup(Model.Edition.Edition.Slug) + "/jogos")">Todos os jogos ↗</a></div>@if (Model.Matches.Items.Count == 0) { <div class="empty-state"><h3>Os jogos ainda não estão disponíveis.</h3><p>Acompanhe esta página para encontrar a agenda e os resultados da edição.</p></div> } else { <div class="match-grid">@foreach (var game in Model.Matches.Items) { <partial name="_MatchCard" model="new MatchCard(Model.Edition.Edition, game)" /> }</div> }</section>
<section class="shell section section-tight"><div class="section-heading"><div><p class="eyebrow">AS CORES DESSA HISTÓRIA</p><h2>Equipes participantes</h2></div><a class="text-link" href="@(PortalRoutes.Cup(Model.Edition.Edition.Slug) + "/equipes")">Todas as equipes ↗</a></div><div class="team-grid">@foreach (var team in Model.Teams.Items) { <a class="team-tile" href="@PortalRoutes.Team(Model.Edition.Edition.Slug, team.Id)"><span class="team-avatar" aria-hidden="true">@PortalFormat.Initials(team.Name)</span><h3>@team.Name</h3><span class="text-link">Conhecer equipe ↗</span></a> }</div>@if (Model.Teams.Items.Count == 0) { <p class="muted">As equipes desta edição ainda não estão disponíveis.</p> }</section>
<section class="shell shortcut-grid section"><a class="shortcut" href="@(PortalRoutes.Cup(Model.Edition.Edition.Slug) + "/estatisticas")"><span aria-hidden="true">↗</span><p class="eyebrow">OS NÚMEROS DO JOGO</p><h3>Estatísticas</h3><p>Gols, resultados e os registros de cada partida.</p></a><a class="shortcut dark" href="@(PortalRoutes.Cup(Model.Edition.Edition.Slug) + "/premiacoes")"><span aria-hidden="true">✦</span><p class="eyebrow">RECONHECIMENTO OFICIAL</p><h3>Os destaques da copa</h3><p>Premiações, craques e conquistas confirmadas.</p></a></section>
