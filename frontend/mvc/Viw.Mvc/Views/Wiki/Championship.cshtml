@model EditionDetailResponse
<section class="wiki-hero compact"><div class="shell"><nav class="breadcrumbs" aria-label="Caminho"><a href="/wiki">Wiki VIW</a><span aria-hidden="true">/</span><span>Memória da copa</span></nav><p class="eyebrow">UM CAPÍTULO DO NOSSO FUTEBOL</p><h1>@Model.Edition.Name</h1><p>@Model.Edition.Year · @(Model.Edition.Semester)º semestre · @PortalFormat.Status(Model.Edition.Status)</p><div class="button-row"><a class="button button-lime" href="@PortalRoutes.Cup(Model.Edition.Slug)">Explorar a copa <span aria-hidden="true">↗</span></a><partial name="_Share" /></div></div></section>
<section class="shell section"><div class="section-heading"><div><p class="eyebrow">A EDIÇÃO EM PERSPECTIVA</p><h2>Os capítulos dessa disputa</h2></div></div><div class="stats-grid three"><div class="stat-tile highlight"><span>Equipes participantes</span><strong>@Model.Teams</strong><a class="text-link" href="@(PortalRoutes.Cup(Model.Edition.Slug) + "/equipes")">Conhecer equipes ↗</a></div><div class="stat-tile"><span>Partidas cadastradas</span><strong>@Model.Matches</strong><a class="text-link" href="@(PortalRoutes.Cup(Model.Edition.Slug) + "/jogos")">Revisitar os jogos ↗</a></div><div class="stat-tile"><span>Fases cadastradas</span><strong>@Model.Phases.Count</strong><a class="text-link" href="@(PortalRoutes.Cup(Model.Edition.Slug) + "/premiacoes")">Ver premiações ↗</a></div></div>
@if (Model.Phases.Count > 0) { <div class="panel"><h3>Estrutura da competição</h3><ol class="phase-list">@foreach (var phase in Model.Phases) { <li><strong>@phase.Name</strong>@{ var rounds = Model.Rounds.Where(x => x.PhaseId == phase.Id).ToArray(); }@if (rounds.Length > 0) { <p class="muted">@string.Join(" · ", rounds.Select(x => x.Name))</p> }</li> }</ol></div> }</section>
<section class="shell wiki-banner"><div><p class="eyebrow">QUEM ESCREVEU ESSA HISTÓRIA</p><h2>Os nomes por trás<br />de cada partida.</h2><p>Encontre os jogadores que fizeram parte desta edição e continue pela trajetória de cada um.</p><a class="button button-primary" href="@("/wiki/jogadores?edicao=" + Model.Edition.Id.ToString("D"))">Jogadores da edição ↗</a></div><div class="wiki-banner-art" aria-hidden="true"><span>WIKI</span><b>VIW</b></div></section>
