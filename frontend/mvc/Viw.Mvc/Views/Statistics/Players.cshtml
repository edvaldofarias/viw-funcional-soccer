@model PlayerStatsPage
<partial name="_EditionHeader" model="Model.Edition" />
<section class="shell section"><div class="section-heading"><div><p class="eyebrow">OS NÚMEROS DA COPA</p><h2>Estatísticas dos jogadores</h2></div></div><nav class="segment-nav" aria-label="Tipo de estatística"><a class="active" aria-current="page" href="@(PortalRoutes.Cup(Model.Edition.Edition.Slug) + "/estatisticas/jogadores")">Jogadores</a><a href="@(PortalRoutes.Cup(Model.Edition.Edition.Slug) + "/estatisticas/equipes")">Equipes</a></nav><partial name="_StatisticsNote" />
@if (Model.Players.Items.Count == 0) { <div class="empty-state"><h3>Os números ainda estão sendo construídos.</h3><p>A tabela aparecerá quando houver estatísticas registradas em partidas encerradas.</p></div> } else { <div class="table-wrap"><table><caption class="sr-only">Totais dos jogadores nas partidas encerradas da edição</caption><thead><tr><th>Jogador</th><th class="numeric">Gols</th><th class="numeric">Amarelos</th><th class="numeric">Vermelhos</th><th>Presenças</th><th>Registros</th></tr></thead><tbody>@foreach (var player in Model.Players.Items) { var stats = player.Statistics; <tr><td><a class="person-link" href="@PortalRoutes.Player(player.Player.Slug)"><span class="avatar small" aria-hidden="true">@PortalFormat.Initials(player.Player.Name)</span>@player.Player.Name</a></td><td class="numeric goals-cell">@stats.Goals</td><td class="numeric">@stats.YellowCards</td><td class="numeric">@stats.RedCards</td><td><strong>@stats.KnownAppearances</strong> confirmadas @if (stats.UnknownAppearances > 0) { <small class="cell-note">@stats.UnknownAppearances sem confirmação</small> }</td><td>@if (stats.IncompleteSheets > 0) { <span class="status status-unknown">@stats.IncompleteSheets parciais</span> } else { <span class="muted">Sem pendências de súmula</span> }</td></tr> }</tbody></table></div> }<partial name="_Pagination" model="Model.Pager" /></section>
