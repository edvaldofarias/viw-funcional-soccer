@model TeamStatsPage
<partial name="_EditionHeader" model="Model.Edition" />
<section class="shell section"><div class="section-heading"><div><p class="eyebrow">CADA RESULTADO CONTA</p><h2>Estatísticas das equipes</h2></div></div><nav class="segment-nav" aria-label="Tipo de estatística"><a href="@(PortalRoutes.Cup(Model.Edition.Edition.Slug) + "/estatisticas/jogadores")">Jogadores</a><a class="active" aria-current="page" href="@(PortalRoutes.Cup(Model.Edition.Edition.Slug) + "/estatisticas/equipes")">Equipes</a></nav><aside class="notice"><span class="notice-icon" aria-hidden="true">i</span><p>Resultados de partidas encerradas com placares confirmados, em ordem alfabética. Esta tabela não atribui pontos nem posições de classificação.</p></aside>@if (Model.Teams.Items.Count == 0) { <div class="empty-state"><h3>Ainda não há equipes para exibir.</h3><p>Volte quando os participantes estiverem disponíveis.</p></div> } else { <div class="table-wrap"><table><caption class="sr-only">Resultados acumulados das equipes, sem classificação por pontos</caption><thead><tr><th>Equipe</th><th class="numeric">Jogos</th><th class="numeric"><abbr title="Vitórias">V</abbr></th><th class="numeric"><abbr title="Empates">E</abbr></th><th class="numeric"><abbr title="Derrotas">D</abbr></th><th class="numeric">Gols pró</th><th class="numeric">Gols contra</th><th class="numeric">Saldo</th></tr></thead><tbody>@foreach (var item in Model.Teams.Items) { <tr><td><a class="person-link" href="@PortalRoutes.Team(Model.Edition.Edition.Slug, item.Team.Id)"><span class="team-avatar small" aria-hidden="true">@PortalFormat.Initials(item.Team.Name)</span>@item.Team.Name</a></td><td class="numeric">@item.Played</td><td class="numeric">@item.Wins</td><td class="numeric">@item.Draws</td><td class="numeric">@item.Losses</td><td class="numeric strong">@item.GoalsFor</td><td class="numeric">@item.GoalsAgainst</td><td class="numeric">@(item.GoalsFor - item.GoalsAgainst)</td></tr> }</tbody></table></div> }<partial name="_Pagination" model="Model.Pager" /></section>
