@model WikiPlayerPage
@{ var player = Model.Player.Player; var stats = Model.Player.Statistics; }
<section class="player-header"><div class="shell"><nav class="breadcrumbs" aria-label="Caminho"><a href="/wiki">Wiki VIW</a><span aria-hidden="true">/</span><a href="/wiki/jogadores">Jogadores</a></nav><div class="profile-heading"><span class="avatar jumbo" aria-hidden="true">@PortalFormat.Initials(player.Name)</span><div class="grow"><p class="eyebrow">IDENTIDADE VIW</p><h1>@player.Name</h1><p>A trajetória de quem faz o nosso futebol.</p></div><partial name="_Share" /></div></div></section>
<section class="shell section"><div class="section-heading"><div><p class="eyebrow">NÚMEROS REGISTRADOS DA CARREIRA</p><h2>A história em campo</h2></div></div><div class="stats-grid"><div class="stat-tile highlight"><span>Gols registrados</span><strong>@stats.Goals</strong><small>Em partidas encerradas</small></div><div class="stat-tile"><span>Presenças confirmadas</span><strong>@stats.KnownAppearances</strong><small>@stats.UnknownAppearances registros sem confirmação</small></div><div class="stat-tile"><span>Cartões amarelos</span><strong>@stats.YellowCards</strong><small>Conforme as súmulas disponíveis</small></div><div class="stat-tile"><span>Cartões vermelhos</span><strong>@stats.RedCards</strong><small>Conforme as súmulas disponíveis</small></div></div><aside class="notice"><span class="notice-icon" aria-hidden="true">i</span><p>Estes totais reúnem os registros disponíveis nas súmulas de partidas encerradas. Há <strong>@stats.IncompleteSheets registros de súmulas parciais</strong>. Presenças desconhecidas não significam ausência.</p></aside></section>
<section class="shell section section-tight"><div class="section-heading"><div><p class="eyebrow">DE UMA COPA À OUTRA</p><h2>Passagens pela VIW</h2></div></div>@if (Model.History.Items.Count == 0) { <div class="empty-state"><h3>As participações ainda não estão disponíveis.</h3><p>Os registros desta identidade serão reunidos aqui.</p></div> } else { <div class="timeline">@foreach (var entry in Model.History.Items) { <article class="timeline-item"><div class="timeline-year">@entry.Edition.Year<span>@(entry.Edition.Semester)º semestre</span></div><div class="timeline-card"><p class="eyebrow">@PortalFormat.Status(entry.Edition.Status)</p><h3><a href="@PortalRoutes.Cup(entry.Edition.Slug)">@entry.Edition.Name</a></h3><a class="person-link" href="@PortalRoutes.Team(entry.Edition.Slug, entry.Team.Id)"><span class="team-avatar small" aria-hidden="true">@PortalFormat.Initials(entry.Team.Name)</span>@entry.Team.Name</a><p class="muted">Nome na edição: <strong>@entry.OriginalName</strong></p></div></article> }</div> }<partial name="_Pagination" model="Model.Pager" /></section>
