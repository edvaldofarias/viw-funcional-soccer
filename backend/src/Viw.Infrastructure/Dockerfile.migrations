FROM mcr.microsoft.com/dotnet/sdk:10.0
WORKDIR /src/backend
COPY backend/ ./
RUN dotnet tool restore && dotnet build src/Viw.Infrastructure/Viw.Infrastructure.csproj --configuration Release
ENTRYPOINT ["dotnet", "ef", "database", "update", "--project", "src/Viw.Infrastructure", "--configuration", "Release", "--no-build"]
