@model WikiPlayersPage
<section class="shell page-header"><nav class="breadcrumbs" aria-label="Caminho"><a href="/wiki">Wiki VIW</a><span aria-hidden="true">/</span><span>Jogadores</span></nav><p class="eyebrow">OS PROTAGONISTAS DO NOSSO FUTEBOL</p><h1>Jogadores<span class="accent">.</span></h1><p>Cada nome, uma trajetória. Encontre quem fez parte das copas da VIW.</p></section>
<section class="shell section section-tight"><form class="filter-bar" method="get" action="/wiki/jogadores"><div class="grow"><label for="busca">Nome ou apelido</label><input id="busca" name="busca" type="search" value="@Model.Search" maxlength="100" placeholder="Busque um jogador" /></div><div><label for="edicao">Campeonato</label><select id="edicao" name="edicao"><option value="">Todas as edições</option>@foreach (var cup in Model.Editions) { <option value="@cup.Id" selected="@(Model.EditionId == cup.Id)">@cup.Name · @cup.Year</option> }</select></div><button class="button button-primary" type="submit">Buscar <span aria-hidden="true">↗</span></button>@if (Model.Search != null || Model.EditionId != null) { <a class="text-link" href="/wiki/jogadores">Limpar filtros</a> }</form><p class="result-count">@Model.Players.TotalCount identidades encontradas</p>@if (Model.Players.Items.Count == 0) { <div class="empty-state"><h2>Ninguém encontrado com esses filtros.</h2><p>Tente outro nome, apelido ou edição.</p></div> } else { <div class="player-grid">@foreach (var player in Model.Players.Items) { <a class="player-tile" href="@PortalRoutes.Player(player.Slug)"><span class="avatar large" aria-hidden="true">@PortalFormat.Initials(player.Name)</span><div><h2>@player.Name</h2><p>Ver trajetória <span aria-hidden="true">↗</span></p></div></a> }</div> }<partial name="_Pagination" model="Model.Pager" /></section>
